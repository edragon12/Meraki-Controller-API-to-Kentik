# Copy this file to .env and replace placeholder values.
# Keep .env private: chmod 600 .env
MERAKI_API_KEY=
MERAKI_ORG_ID=
KENTIK_INGEST_URL=https://grpc.api.kentik.com/kmetrics/v202207/metrics/api/v2/write?bucket=&org=&precision=ns
KENTIK_EMAIL=
KENTIK_API_TOKEN=
MERAKI_BASE_URL=https://api.meraki.com/api/v1
HTTP_TIMEOUT_SECONDS=20
# Retries for transient Meraki/Kentik failures; 429 Retry-After is honored.
HTTP_MAX_RETRIES=3
HTTP_RETRY_BACKOFF_SECONDS=1.0
# Maximum Meraki Link-header pages followed per API request.
MERAKI_MAX_PAGES=100
# last_connected is a dimension; rounding limits new series. 3600=hourly, 86400=daily, 0=exact seconds.
LAST_CONNECTED_ROUND_SECONDS=3600
# Client list lookback in seconds; 86400 matches Meraki's default one-day view.
MERAKI_CLIENT_TIMESPAN=86400
MAX_WIRELESS_CLIENTS=100
MAX_WIRELESS_ACCESS_POINTS=100
